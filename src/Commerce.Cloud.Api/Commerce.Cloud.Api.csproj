<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Npgsql only. Design.md explicitly rejects EF Core (raw NpgsqlDataSource +
      parameterized commands so tenant scoping can be forced into an explicit
      transaction per operation). ASP.NET Core Identity's cookie authentication
      scheme ships in the shared framework (Microsoft.AspNetCore.App) and needs
      no extra package reference; it is composed in Program.cs without an
      EF-backed UserStore, since Unit 2's scope is host + tenant-scoped
      persistence, not the full Identity user-management surface (deferred to
      the SPA/auth-flow work in Unit 3).
    -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Commerce.Domain\Commerce.Domain.csproj" />
    <ProjectReference Include="..\Commerce.Application\Commerce.Application.csproj" />
    <ProjectReference Include="..\Commerce.BranchNode\Commerce.BranchNode.csproj" />
  </ItemGroup>

</Project>
