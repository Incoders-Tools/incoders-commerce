<UserControl x:Class="Commerce.Pos.Windows.LockScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <!-- Big, calm tiles: an initials disc, the email and the role. -->
        <Style x:Key="OperatorTileButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="190" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="12,16" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="KeypadButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource CardBorder}" MaxWidth="500" Margin="24" Padding="28,24"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel MinWidth="380">
                <TextBlock x:Name="BranchText" Style="{StaticResource EyebrowTextBlock}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TitleText" Style="{StaticResource HeroTextBlock}" FontSize="26" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,4,0,18" />

                <StackPanel x:Name="FormPanel">
                    <!-- Operators already on this terminal: tap a tile, then the PIN. -->
                    <StackPanel x:Name="TilesPanel">
                        <ItemsControl x:Name="TilesItemsControl" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource OperatorTileButton}" Tag="{Binding UserId}" Click="TileButton_Click"
                                            AutomationProperties.Name="{Binding Email}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Initials}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource OnPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Email}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="160" Margin="0,10,0,0" />
                                            <TextBlock Text="{Binding Role}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                                       TextAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="CredentialsLinkButton" Content="Ingresar con usuario y contraseña" HorizontalAlignment="Center"
                                Margin="0,14,0,0" Style="{StaticResource GhostButton}" Click="CredentialsLinkButton_Click" />
                    </StackPanel>

                    <!-- The PIN of the tapped operator: a PIN box plus a keypad for touch screens. -->
                    <StackPanel x:Name="PinPanel">
                        <PasswordBox x:Name="PinBox" MaxLength="6" FontSize="28" HorizontalContentAlignment="Center" PasswordChar="●"
                                     PasswordChanged="PinBox_PasswordChanged" KeyDown="PinBox_KeyDown" AutomationProperties.Name="PIN" />
                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <Button Content="1" Tag="1" Style="{StaticResource KeypadButton}" Click="KeypadButton_Click" />
                            <Button Content="2" Tag="2" Style="{StaticResource KeypadButton}" Click="KeypadButton_Click" />
                            <Button Content="3" Tag="3" Style="{StaticResource KeypadButton}" Click="KeypadButton_Click" />
                            <Button Content="4" Tag="4" Style="{StaticResource KeypadButton}" Click="KeypadButton_Click" />
                            <Button Content="5" Tag="5" Style="{StaticResource KeypadButton}" Click="KeypadButton_Click" />
                            <Button Content="6" Tag="6" Style="{StaticResource KeypadButton}" Click="KeypadButton_Click" />
                            <Button Content="7" Tag="7" Style="{StaticResource KeypadButton}" Click="KeypadButton_Click" />
                            <Button Content="8" Tag="8" Style="{StaticResource KeypadButton}" Click="KeypadButton_Click" />
                            <Button Content="9" Tag="9" Style="{StaticResource KeypadButton}" Click="KeypadButton_Click" />
                            <Button Content="Borrar" FontSize="14" Style="{StaticResource KeypadButton}" Click="KeypadClearButton_Click" />
                            <Button Content="0" Tag="0" Style="{StaticResource KeypadButton}" Click="KeypadButton_Click" />
                            <Button Content="⌫" Style="{StaticResource KeypadButton}" Click="KeypadBackspaceButton_Click" AutomationProperties.Name="Borrar un dígito" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- Email + password, verified online. -->
                    <StackPanel x:Name="CredentialsPanel">
                        <TextBlock Text="Correo" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,4" />
                        <TextBox x:Name="EmailTextBox" Margin="0,0,0,10" KeyDown="CredentialsBox_KeyDown" AutomationProperties.Name="Correo" />
                        <TextBlock Text="Contraseña" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12" KeyDown="CredentialsBox_KeyDown" AutomationProperties.Name="Contraseña" />
                        <CheckBox x:Name="ResetPinCheckBox" Content="Olvidé mi PIN: quiero crear uno nuevo" Margin="0,0,0,14"
                                  Foreground="{DynamicResource MutedTextBrush}" Checked="ResetPinCheckBox_Changed" Unchecked="ResetPinCheckBox_Changed" />
                        <Button x:Name="SignInButton" Content="Ingresar" HorizontalAlignment="Stretch" MinHeight="44" Click="SignInButton_Click" />
                    </StackPanel>

                    <!-- First time here (or a reset): choose the PIN. -->
                    <StackPanel x:Name="CreatePinPanel">
                        <TextBlock Text="PIN nuevo (6 dígitos)" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="NewPinBox" MaxLength="6" FontSize="22" HorizontalContentAlignment="Center" PasswordChar="●"
                                     Margin="0,0,0,10" KeyDown="CreatePinBox_KeyDown" AutomationProperties.Name="PIN nuevo" />
                        <TextBlock Text="Repetí el PIN" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="ConfirmPinBox" MaxLength="6" FontSize="22" HorizontalContentAlignment="Center" PasswordChar="●"
                                     Margin="0,0,0,14" KeyDown="CreatePinBox_KeyDown" AutomationProperties.Name="Repetir PIN" />
                        <Button x:Name="SavePinButton" Content="Guardar PIN y entrar" HorizontalAlignment="Stretch" MinHeight="44" Click="SavePinButton_Click" />
                    </StackPanel>

                    <Button x:Name="BackButton" Content="Volver" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Style="{StaticResource GhostButton}" Click="BackButton_Click" />
                </StackPanel>

                <StackPanel x:Name="BusyPanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <ProgressBar x:Name="BusyProgressBar" IsIndeterminate="True" Height="6" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderBrushMuted}" />
                    <TextBlock x:Name="BusyText" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>

                <Border x:Name="StatusBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="10" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
