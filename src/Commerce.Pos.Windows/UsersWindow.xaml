<Window x:Class="Commerce.Pos.Windows.UsersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Manage staff" Height="600" Width="720" WindowStartupLocation="CenterOwner" Icon="app.ico">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel x:Name="SignInPanel"><TextBlock Text="Sign in as an administrator" FontWeight="Bold"/><TextBox x:Name="AdminEmailTextBox" Margin="0,8,0,4"/><PasswordBox x:Name="AdminPasswordBox"/><Button Content="Sign in" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SignInButton_Click"/><TextBlock x:Name="StatusText" Foreground="DarkRed" TextWrapping="Wrap"/></StackPanel>
  <Grid x:Name="ManagementPanel" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><Button Content="New staff user" DockPanel.Dock="Top" Click="NewUserButton_Click"/><ListBox x:Name="UsersListBox" DisplayMemberPath="Email" SelectionChanged="UsersListBox_SelectionChanged"/></DockPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="Email"/><TextBox x:Name="EmailTextBox"/><TextBlock Text="Password" Margin="0,8,0,0"/><PasswordBox x:Name="PasswordBox"/><TextBlock Text="Roles" Margin="0,8,0,0"/><ItemsControl x:Name="RolesItemsControl"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Save staff user / roles" Margin="0,8,0,0" Click="SaveButton_Click"/><Button Content="Reset password" Margin="0,8,0,0" Click="ResetPasswordButton_Click"/><TextBlock x:Name="FormStatusText" Foreground="DarkRed" TextWrapping="Wrap"/></StackPanel>
  </Grid>
 </Grid>
</Window>
