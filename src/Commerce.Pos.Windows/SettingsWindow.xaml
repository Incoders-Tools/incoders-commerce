<Window x:Class="Commerce.Pos.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de terminal" Height="640" Width="620" MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="CONFIGURACIÓN" Style="{StaticResource EyebrowTextBlock}" />
                <TextBlock Text="Terminal" Style="{StaticResource HeroTextBlock}" />
                <TextBlock Text="Ajustes seguros para la terminal sin quitar espacio a la venta." Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource SoftCardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Apariencia" Style="{StaticResource SectionTitleTextBlock}" />
                    <TextBlock Text="El tema se guarda para esta terminal y se aplica al instante a las ventanas abiertas." Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="DarkThemeButton" Content="Oscuro" Tag="Dark" Style="{StaticResource AppearanceThemeOption}" Checked="ThemeRadioButton_Checked" Margin="0,0,6,0" />
                        <RadioButton x:Name="LightThemeButton" Content="Claro" Tag="Light" Style="{StaticResource AppearanceThemeOption}" Checked="ThemeRadioButton_Checked" Margin="6,0,6,0" />
                        <RadioButton x:Name="VacaVerdeThemeButton" Content="Vaca Verde" Tag="VacaVerde" Style="{StaticResource AppearanceThemeOption}" Checked="ThemeRadioButton_Checked" Margin="6,0,0,0" />
                    </UniformGrid>
                    <TextBlock x:Name="ThemeStatusText" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Sincronización" Style="{StaticResource SectionTitleTextBlock}" />
                    <Button x:Name="SyncPendingButton" Content="Sincronizar pendientes" HorizontalAlignment="Stretch" Click="SyncPendingButton_Click" />
                    <TextBlock x:Name="SyncResultText" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Sucursal y estado" Style="{StaticResource SectionTitleTextBlock}" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Identidad técnica" Style="{StaticResource SectionTitleTextBlock}" />
                    <TextBlock x:Name="IdentityText" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,14" />
                    <Button Content="Reconfigurar terminal" HorizontalAlignment="Stretch" Click="ReconfigureTerminalButton_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SoftCardBorder}">
                <StackPanel>
                    <TextBlock Text="Versión y actualizaciones" Style="{StaticResource SectionTitleTextBlock}" />
                    <TextBlock x:Name="VersionStatusText" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
