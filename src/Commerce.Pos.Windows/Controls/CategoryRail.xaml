<UserControl x:Class="Commerce.Pos.Windows.Controls.CategoryRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ListBox x:Name="RailList" BorderThickness="0" Background="Transparent" Padding="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="RailList_SelectionChanged"
             AutomationProperties.Name="Categorías">
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RailChrome" Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource BorderBrushMuted}"
                                    BorderThickness="1" CornerRadius="10" MinHeight="64" Padding="6,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RailGlyph" Text="{Binding Glyph}" Style="{StaticResource IconTextBlock}" FontSize="20" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock x:Name="RailLabel" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RailChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RailChrome" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="RailChrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="RailGlyph" Property="Foreground" Value="White" />
                                    <Setter TargetName="RailLabel" Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
    </ListBox>
</UserControl>
