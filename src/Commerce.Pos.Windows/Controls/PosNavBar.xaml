<UserControl x:Class="Commerce.Pos.Windows.Controls.PosNavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Icon and label take the button's foreground so the active and disabled states tint both. -->
        <Style x:Key="NavIcon" TargetType="TextBlock" BasedOn="{StaticResource IconTextBlock}">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="NavEntry" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource ShellElevatedBrush}" BorderBrush="{DynamicResource BorderBrushMuted}" BorderThickness="0,0,0,1" Padding="12,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="NewSaleButton" Style="{StaticResource NavEntry}" Tag="Active" AutomationProperties.Name="Nueva Venta">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconAdd}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Nueva Venta" Style="{StaticResource NavLabel}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NavEntry}" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Productos">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconProducts}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Productos" Style="{StaticResource NavLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="CustomersButton" Style="{StaticResource NavEntry}" Visibility="Collapsed" Click="CustomersButton_Click" AutomationProperties.Name="Clientes">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconCustomers}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Clientes" Style="{StaticResource NavLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StaffButton" Style="{StaticResource NavEntry}" Visibility="Collapsed" Click="StaffButton_Click" AutomationProperties.Name="Personal">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconStaff}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Personal" Style="{StaticResource NavLabel}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NavEntry}" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Reportes">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconReports}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Reportes" Style="{StaticResource NavLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SyncNavButton" Style="{StaticResource NavEntry}" Click="SyncButton_Click" AutomationProperties.Name="Sincronización">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconSync}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Sincronización" Style="{StaticResource NavLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsNavButton" Style="{StaticResource NavEntry}" Click="SettingsButton_Click" AutomationProperties.Name="Configuración">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconSettings}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Configuración" Style="{StaticResource NavLabel}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NavEntry}" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Cerrar Caja">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconRegister}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Cerrar Caja" Style="{StaticResource NavLabel}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- The active operator doubles as the switch-operator action. -->
            <Button x:Name="OperatorButton" Grid.Column="2" Style="{StaticResource NavButton}" Click="OperatorButton_Click"
                    ToolTip="Cambiar operador" AutomationProperties.Name="Cambiar operador" MaxWidth="170">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource IconOperator}" Style="{StaticResource NavIcon}" />
                    <TextBlock x:Name="OperatorText" Text="Sin operador activo" Style="{StaticResource NavLabel}" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
