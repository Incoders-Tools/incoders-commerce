<UserControl x:Class="Commerce.Pos.Windows.Controls.CustomerSearchPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Grid>
        <!-- Looks like the other pickers (the ComboBox chrome); opens a popup with a search box over the synced customers. -->
        <Button x:Name="OpenButton" MinHeight="38" Cursor="Hand" Click="OpenButton_Click" PreviewMouseDown="OpenButton_PreviewMouseDown"
                ToolTip="Elegir o buscar el cliente de la venta" AutomationProperties.Name="Cliente de la venta">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrushMuted}"
                            BorderThickness="1" CornerRadius="10" Padding="12,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{DynamicResource IconFontFamily}" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock x:Name="SelectedLabelText" Text="Consumidor final" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
        </Button>

        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=OpenButton}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="SearchPopup_Opened" Closed="SearchPopup_Closed">
            <Border Style="{StaticResource CardBorder}" Padding="10" CornerRadius="12" Margin="0,4,8,8" TextElement.Foreground="{DynamicResource TextBrush}">
                <StackPanel Width="340">
                    <Grid>
                        <TextBox x:Name="SearchTextBox" Padding="28,8,10,8" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                                 AutomationProperties.Name="Buscar cliente por nombre, CUIT o localidad" />
                        <TextBlock Text="{StaticResource IconSearch}" Style="{StaticResource IconTextBlock}" FontSize="14" Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                        <!-- The placeholder is a TextBox laid over the search box with the same template, padding and font (as the sale's
                             product search), so its text starts exactly where the caret does. Transparent and inert. -->
                        <TextBox x:Name="SearchPlaceholderText" Text="Buscar por nombre, CUIT o localidad…" Padding="28,8,10,8" VerticalContentAlignment="Center"
                                 IsHitTestVisible="False" Focusable="False" IsTabStop="False" IsReadOnly="True"
                                 Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>
                    <ListBox x:Name="ResultsListBox" Margin="0,8,0,0" MaxHeight="320" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                             PreviewMouseLeftButtonUp="ResultsListBox_PreviewMouseLeftButtonUp" KeyDown="ResultsListBox_KeyDown"
                             AutomationProperties.Name="Clientes">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis" Opacity="0.75"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoMatchesText" Text="Ningún cliente coincide con la búsqueda." Style="{StaticResource MutedTextBlock}"
                               FontSize="12" Margin="4,8,4,2" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
