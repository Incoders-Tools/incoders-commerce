<UserControl x:Class="Commerce.Pos.Windows.Controls.TotalsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}" Padding="16,12" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- No tax line yet: the IVA breakdown is Phase 2. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Subtotal" Style="{StaticResource MutedTextBlock}" />
                <TextBlock x:Name="SubtotalText" Grid.Column="1" Text="$0.00" Style="{StaticResource MutedTextBlock}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,2,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL" FontSize="16" FontWeight="SemiBold" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="ScannedTotalText" Text="$0.00" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CommitScannedSaleButton" Grid.Column="1" Content="Cobrar venta" MinWidth="150" MinHeight="46" FontSize="15" Click="CommitButton_Click" />
            </Grid>

            <!-- Payment methods arrive in Phase 2; disabled with an explanatory tooltip until then. -->
            <UniformGrid Grid.Row="2" Rows="1">
                <UniformGrid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource TenderButton}">
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="ToolTip" Value="Próximamente" />
                    </Style>
                </UniformGrid.Resources>
                <Button Content="Efectivo" />
                <Button Content="Tarjeta" />
                <Button Content="QR" Margin="0" />
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
