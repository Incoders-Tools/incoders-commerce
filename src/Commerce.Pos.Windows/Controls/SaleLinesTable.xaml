<UserControl x:Class="Commerce.Pos.Windows.Controls.SaleLinesTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Border Style="{StaticResource CardBorder}" Padding="0" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column widths are shared with the row template below; keep them in sync. -->
            <Border x:Name="HeaderRow" Grid.Row="0" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="12,12,0,0" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="90" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Producto" Style="{StaticResource TableHeaderTextBlock}" />
                    <TextBlock Grid.Column="1" Text="SKU" Style="{StaticResource TableHeaderTextBlock}" />
                    <TextBlock Grid.Column="2" Text="Cant." Style="{StaticResource TableHeaderTextBlock}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Precio" Style="{StaticResource TableHeaderTextBlock}" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Total" Style="{StaticResource TableHeaderTextBlock}" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Acciones" Style="{StaticResource TableHeaderTextBlock}" TextAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="RowsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" ScrollChanged="RowsScrollViewer_ScrollChanged">
                <ItemsControl x:Name="RowsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrushMuted}" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PriceNote}" FontSize="11" Style="{StaticResource MutedTextBlock}" />
                                        <TextBlock Text="{Binding DiscountText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding IdentificationCode}" Style="{StaticResource MutedTextBlock}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding QuantityText}" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding UnitPriceText}" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding NetTotalText}" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ToggleButton x:Name="EditToggle" Width="32" Height="32" Cursor="Hand" ToolTip="Editar cantidad"
                                                      Margin="{StaticResource ActionSpacing}" Checked="EditToggle_Checked"
                                                      AutomationProperties.Name="Editar cantidad">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="8">
                                                        <TextBlock Text="{StaticResource IconEdit}" Style="{StaticResource IconTextBlock}" Foreground="{DynamicResource AccentTextBrush}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=EditToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=EditToggle}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="EditPopup_Opened">
                                            <Border Style="{StaticResource CardBorder}" Padding="12" CornerRadius="10" Margin="6" TextElement.Foreground="{DynamicResource TextBrush}">
                                                <StackPanel Width="150">
                                                    <TextBlock Text="Cantidad" Style="{StaticResource MutedTextBlock}" FontSize="12" Margin="0,0,0,6" />
                                                    <TextBox x:Name="QuantityEditBox" Text="{Binding QuantityEditText, Mode=OneWay}" KeyDown="QuantityEditBox_KeyDown" />
                                                    <Button Content="Aplicar" Margin="0,8,0,0" Click="ApplyQuantityButton_Click" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                        <Button Style="{StaticResource IconButton}" Margin="{StaticResource ActionSpacing}" Click="DiscountButton_Click" ToolTip="Aplicar descuento" AutomationProperties.Name="Aplicar descuento">
                                            <TextBlock Text="%" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Click="DeleteButton_Click" ToolTip="Quitar de la venta" AutomationProperties.Name="Quitar de la venta">
                                            <TextBlock Text="{StaticResource IconDelete}" Style="{StaticResource IconTextBlock}" Foreground="{DynamicResource DangerBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="{StaticResource IconEmptyCart}" Style="{StaticResource IconTextBlock}" FontSize="30" Foreground="{DynamicResource MutedTextBrush}" Opacity="0.6" />
                <TextBlock Text="La venta está vacía" Style="{StaticResource MutedTextBlock}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="Escanee un producto o toque una tarjeta." Style="{StaticResource MutedTextBlock}" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
