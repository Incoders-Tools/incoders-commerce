<Window x:Class="Commerce.Pos.Windows.ProvisionOperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar operador" Height="720" Width="520" WindowStartupLocation="CenterScreen" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="OPERADOR DE ESTA TERMINAL" Style="{StaticResource EyebrowTextBlock}" />
                    <TextBlock Text="Agregar operador" Style="{StaticResource HeroTextBlock}" />
                    <TextBlock Text="Ingresá el correo y la contraseña del operador y elegí un PIN de 6 dígitos. Se necesita conexión una sola vez."
                               Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" />
                </StackPanel>


                <StackPanel x:Name="FormPanel">
                <StackPanel x:Name="AddOperatorPanel" Margin="0,0,0,10">
                    <Border Style="{StaticResource SoftCardBorder}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Correo" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,4" />
                            <TextBox x:Name="EmailTextBox" Margin="0,0,0,8" />

                            <TextBlock Text="Contraseña" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" />

                            <TextBlock Text="PIN nuevo (6 dígitos)" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="NewPinBox" Margin="0,0,0,8" />

                            <TextBlock Text="Confirmar PIN" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="ConfirmPinBox" Margin="0,0,0,10" />

                            <Button x:Name="ProvisionButton" Content="Guardar operador" HorizontalAlignment="Stretch" Click="ProvisionButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button x:Name="ContinueWithoutOperatorButton" Content="Continuar sin operador" HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="ContinueWithoutOperatorButton_Click" Style="{StaticResource GhostButton}" />
                </StackPanel>

                <StackPanel x:Name="BusyPanel" Visibility="Collapsed" Margin="0,0,0,10">
                    <ProgressBar x:Name="BusyProgressBar" IsIndeterminate="True" Height="6" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderBrushMuted}" />
                    <TextBlock x:Name="BusyText" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>

                <Border Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
