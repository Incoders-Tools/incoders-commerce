<Window x:Class="Commerce.Pos.Windows.CloseCashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cerrar caja" Width="900" SizeToContent="Height" WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SummaryTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleTextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- One summary row: the label takes the free width (and wraps), the amount keeps its own; a hint goes below. -->
        <DataTemplate x:Key="SummaryLine">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedTextBlock}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"
                           VerticalAlignment="Top" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="CAJA" Style="{StaticResource EyebrowTextBlock}" />
                <TextBlock Text="Cerrar caja" Style="{StaticResource HeroTextBlock}" FontSize="22" />
                <TextBlock x:Name="OpenedText" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,14" TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                <!-- Left: what the system recorded in this session, one amount per row. -->
                <StackPanel Grid.Column="0">
                <TextBlock Text="Ventas de la sesión" Style="{StaticResource SummaryTitle}" />
                <ItemsControl x:Name="SalesItems" ItemTemplate="{StaticResource SummaryLine}" Focusable="False"
                              AutomationProperties.Name="Ventas de la sesión" />

                <TextBlock Text="Cobros y movimientos de caja" Style="{StaticResource SummaryTitle}" Margin="0,8,0,6" />
                <ItemsControl x:Name="OtherMoneyItems" ItemTemplate="{StaticResource SummaryLine}" Focusable="False"
                              AutomationProperties.Name="Cobros y movimientos de caja" />

                </StackPanel>

                <!-- Right: the expected cash as a sum, row by row, then its total; the count and the confirmation below. -->
                <StackPanel Grid.Column="2">
                <Border Style="{StaticResource SoftCardBorder}" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <ItemsControl x:Name="ExpectedLinesItems" ItemTemplate="{StaticResource SummaryLine}" Focusable="False"
                                      AutomationProperties.Name="Cómo se forma el efectivo esperado" />
                        <Separator Margin="0,2,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Efectivo esperado" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,16,0" />
                            <TextBlock x:Name="ExpectedCashText" Grid.Column="1" Text="$0.00" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}" AutomationProperties.Name="Efectivo esperado" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Efectivo contado" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <TextBox x:Name="CountedCashTextBox" FontSize="20" Margin="0,0,0,10" TextChanged="CountedCashTextBox_TextChanged"
                         KeyDown="CountedCashTextBox_KeyDown" AutomationProperties.Name="Efectivo contado" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Diferencia" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="DifferenceText" Grid.Column="1" Text="—" FontSize="22" FontWeight="Bold" />
                </Grid>

                <Border x:Name="MessageBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <Button x:Name="ConfirmButton" Content="Confirmar cierre de caja" HorizontalAlignment="Stretch" Click="ConfirmButton_Click" />
                <Button x:Name="CancelButton" Content="Cancelar" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                        Style="{StaticResource GhostButton}" IsCancel="True" />
                </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
