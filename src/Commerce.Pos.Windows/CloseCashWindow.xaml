<Window x:Class="Commerce.Pos.Windows.CloseCashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cerrar caja" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="CAJA" Style="{StaticResource EyebrowTextBlock}" />
                <TextBlock Text="Cerrar caja" Style="{StaticResource HeroTextBlock}" FontSize="22" />
                <TextBlock x:Name="OpenedText" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,14" TextWrapping="Wrap" />

                <!-- What the system expects, computed from the sales recorded in this session. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Cantidad de ventas" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,6" />
                    <TextBlock x:Name="SaleCountText" Grid.Row="0" Grid.Column="1" Text="0" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="1" Text="Total con tarjeta" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,6" />
                    <TextBlock x:Name="CardTotalText" Grid.Row="1" Grid.Column="1" Text="$0.00" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="2" Text="Total con QR" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,6" />
                    <TextBlock x:Name="QrTotalText" Grid.Row="2" Grid.Column="1" Text="$0.00" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="3" Text="Total a cuenta corriente" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,6"
                               ToolTip="Ventas cargadas a la cuenta corriente de clientes: no entran en la caja" />
                    <TextBlock x:Name="AccountTotalText" Grid.Row="3" Grid.Column="1" Text="$0.00" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="4" Text="Cobros de cuenta corriente" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,6"
                               ToolTip="Pagos de clientes a su cuenta corriente: los de efectivo suman al efectivo esperado" />
                    <TextBlock x:Name="CollectionsText" Grid.Row="4" Grid.Column="1" Text="$0.00" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="5" Text="Movimientos de caja" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,6"
                               ToolTip="Retiros (a la caja fuerte, al banco, gastos) e ingresos de efectivo fuera de una venta" />
                    <TextBlock x:Name="CashMovementsText" Grid.Row="5" Grid.Column="1" Text="—" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="6" Text="Efectivo esperado" FontSize="16" FontWeight="SemiBold" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ExpectedCashText" Grid.Row="6" Grid.Column="1" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                </Grid>
                <TextBlock x:Name="ExpectedBreakdownText" Style="{StaticResource MutedTextBlock}" FontSize="12" Margin="0,2,0,14" TextWrapping="Wrap" />

                <TextBlock Text="Efectivo contado" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <TextBox x:Name="CountedCashTextBox" FontSize="20" Margin="0,0,0,10" TextChanged="CountedCashTextBox_TextChanged"
                         KeyDown="CountedCashTextBox_KeyDown" AutomationProperties.Name="Efectivo contado" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Diferencia" FontSize="16" FontWeight="SemiBold" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DifferenceText" Grid.Column="1" Text="—" FontSize="22" FontWeight="Bold" />
                </Grid>

                <Border x:Name="MessageBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <Button x:Name="ConfirmButton" Content="Confirmar cierre de caja" HorizontalAlignment="Stretch" Click="ConfirmButton_Click" />
                <Button x:Name="CancelButton" Content="Cancelar" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                        Style="{StaticResource GhostButton}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
