<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Semantic resources consume the active palette dictionary (DarkTheme.xaml by default). -->
    <SolidColorBrush x:Key="ShellBrush" Color="{DynamicResource ColorShell}" />
    <SolidColorBrush x:Key="ShellElevatedBrush" Color="{DynamicResource ColorShellElevated}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{DynamicResource ColorSurfaceSoft}" />
    <SolidColorBrush x:Key="BorderBrushMuted" Color="{DynamicResource ColorBorder}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource ColorPrimary}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource ColorAccent}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{DynamicResource ColorWarningSurface}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{DynamicResource ColorWarningBorder}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{DynamicResource ColorWarningText}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource ColorDanger}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{DynamicResource ColorDangerSurface}" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource ColorText}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource ColorTextMuted}" />
    <SolidColorBrush x:Key="InputBrush" Color="{DynamicResource ColorInput}" />

    <Thickness x:Key="CardPadding">20</Thickness>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="MutedTextBlock" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style x:Key="EyebrowTextBlock" TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTitleTextBlock" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="HeroTextBlock" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="SoftCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="InputChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppearanceThemeOption" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="OptionChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OptionChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="OptionChrome" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="OptionChrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" />

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrushMuted}" />
        <Setter Property="Margin" Value="0,8,0,16" />
    </Style>

    <!-- Icons: Segoe Fluent Icons (Windows 11) with Segoe MDL2 Assets as the Windows 10 fallback. -->
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:String x:Key="IconAdd">&#xE710;</sys:String>
    <sys:String x:Key="IconRemove">&#xE738;</sys:String>
    <sys:String x:Key="IconEdit">&#xE70F;</sys:String>
    <sys:String x:Key="IconDelete">&#xE74D;</sys:String>
    <sys:String x:Key="IconSearch">&#xE721;</sys:String>
    <sys:String x:Key="IconProducts">&#xE71D;</sys:String>
    <sys:String x:Key="IconCustomers">&#xE716;</sys:String>
    <sys:String x:Key="IconStaff">&#xE77B;</sys:String>
    <sys:String x:Key="IconReports">&#xE9D9;</sys:String>
    <sys:String x:Key="IconSettings">&#xE713;</sys:String>
    <sys:String x:Key="IconSync">&#xE895;</sys:String>
    <sys:String x:Key="IconRegister">&#xE7E8;</sys:String>
    <sys:String x:Key="IconOperator">&#xE748;</sys:String>
    <sys:String x:Key="IconEmptyCart">&#xE7BF;</sys:String>

    <Style x:Key="IconTextBlock" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="TableHeaderTextBlock" TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Top navigation entry. Tag="Active" marks the current screen. -->
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact square button for steppers and row actions; set Foreground for tinted variants. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="IconChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconChrome" Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
                            <Setter TargetName="IconChrome" Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="IconChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
    </Style>

    <!-- Payment method buttons: Phase 2, rendered disabled with an explanatory tooltip. -->
    <Style x:Key="TenderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="ProductCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
</ResourceDictionary>
