<UserControl x:Class="Commerce.Pos.Windows.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Commerce.Pos.Windows.Controls"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="DisplayMemberPath" Value="Label" />
            <Setter Property="SelectedValuePath" Value="Value" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,-4,0,10" />
        </Style>
        <!-- One field of a two-column row; the row's negative margin takes the last gap back. -->
        <Style x:Key="FormCell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="FormRow" TargetType="UniformGrid">
            <Setter Property="Margin" Value="0,0,-12,0" />
        </Style>
        <Style x:Key="FormSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleTextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="PERSONAL" Style="{StaticResource EyebrowTextBlock}" />
            <TextBlock Text="Empleados" Style="{StaticResource HeroTextBlock}" FontSize="24" Margin="0" />
            <TextBlock Text="Los empleados de esta sucursal: legajo, puesto, sueldo pactado, lo que se les debe (o deben) y la mercadería que llevaron. Los sueldos se liquidan en la web, en «Sueldos»."
                       Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Outside the list and the form on purpose: an error must stay visible however far the form is scrolled. -->
        <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource DangerBrush}"
                   Visibility="Collapsed" AutomationProperties.Name="Estado" />

        <StackPanel x:Name="BusyPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,8">
            <ProgressBar IsIndeterminate="True" Height="6" BorderThickness="0"
                         Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderBrushMuted}" />
            <TextBlock x:Name="BusyText" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" />
        </StackPanel>

        <Grid x:Name="FormPanel" Grid.Row="3">
            <controls:EntityListView x:Name="EmployeesListView" EditorWidth="480" HidesClosedEditor="True">
                <controls:EntityListView.EditorContent>
                    <Grid>
                        <!-- The staff file: new or edit. -->
                        <Grid x:Name="FilePanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Datos del legajo y lo que se le paga. No es la liquidación legal (aportes, recibo oficial): eso lo sigue haciendo el contador."
                                               Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <UniformGrid Columns="2" Style="{StaticResource FormRow}">
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Apellido" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="LastNameTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Apellido" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="FirstNameTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Nombre" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Legajo" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="FileNumberTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Legajo"
                                                     ToolTip="Vacío: automático (el siguiente)" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Puesto" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="RoleComboBox" Style="{StaticResource FieldCombo}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                      AutomationProperties.Name="Puesto" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="FileNumberHint" Text="Legajo vacío: automático (el siguiente)." Style="{StaticResource FieldHint}" />
                                    <TextBlock Text="Los puestos se cargan en la web, en Tablas auxiliares → Puestos." Style="{StaticResource FieldHint}" />

                                    <UniformGrid Columns="2" Style="{StaticResource FormRow}">
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Fecha de ingreso" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="HireDateTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Fecha de ingreso"
                                                     ToolTip="dd/mm/aaaa" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="DNI" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="DocumentTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="DNI" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="CUIL" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="CuilTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="CUIL" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="PhoneTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Teléfono" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="Correo" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="EmailTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Correo" />
                                    <TextBlock Text="Domicilio" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AddressTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Domicilio" />

                                    <Separator />
                                    <TextBlock Text="Sueldo" Style="{StaticResource FormSectionTitle}" />
                                    <UniformGrid Columns="2" Style="{StaticResource FormRow}">
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Se le paga" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="FrequencyComboBox" Style="{StaticResource FieldCombo}" AutomationProperties.Name="Se le paga" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Sueldo pactado por período" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="SalaryTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Sueldo pactado por período"
                                                     ToolTip="Ej.: 15.000 o 15.000,50" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="Es el importe base que se propone en cada liquidación de su frecuencia. En cada liquidación se pueden sumar horas extra, premios, aguinaldo, etc."
                                               Style="{StaticResource FieldHint}" />
                                    <!-- employee-lifecycle E2: what an hour of overtime pays (x the multiplier). -->
                                    <TextBlock Text="Valor de la hora extra" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="OvertimeRateTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Valor de la hora extra"
                                             ToolTip="Ej.: 15.000 o 15.000,50" />
                                    <TextBlock Text="Para las horas extra: horas × este valor × el multiplicador (el domingo, ×2). Vacío: no se cargan horas extra."
                                               Style="{StaticResource FieldHint}" />
                                    <CheckBox x:Name="TakesGoodsCheckBox" Margin="0,0,0,4"
                                              Content="Lleva mercadería (se registra en la web o se le vende en el POS a cuenta, y se descuenta del sueldo)"
                                              AutomationProperties.Name="Lleva mercadería" />
                                    <TextBlock Text="Se crea un cliente «Apellido, Nombre (personal)»: la mercadería se registra en la web («Mercadería») o se le vende en el POS a cuenta corriente. Al liquidar, lo que debe se descuenta del sueldo con la bonificación que decidas en ese momento, por producto y sobre el total."
                                               Style="{StaticResource FieldHint}" Margin="0,0,0,10" />

                                    <TextBlock Text="Observaciones" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="NotesTextBox" Style="{StaticResource FieldBox}" MaxLength="1000" AutomationProperties.Name="Observaciones" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Outside the scroll area: Guardar is always reachable. -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{StaticResource ActionGroupSpacing}">
                                <Button x:Name="SaveButton" Content="Guardar" Margin="{StaticResource ActionSpacing}" Click="SaveButton_Click" />
                                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Click="CancelEditorButton_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- An advance: money out of a treasury account, a debit on the employee's account. -->
                        <StackPanel x:Name="AdvancePanel" Visibility="Collapsed">
                            <TextBlock Text="El dinero sale de la cuenta de Tesorería que elijas y queda en la cuenta del empleado: la próxima liquidación lo descuenta."
                                       Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="Importe" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="AdvanceAmountTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Importe" ToolTip="Ej.: 15.000 o 15.000,50" />
                            <TextBlock Text="Sale de" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="AdvanceAccountComboBox" Style="{StaticResource FieldCombo}" AutomationProperties.Name="Sale de" />
                            <TextBlock Text="Fecha" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="AdvanceDateTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Fecha" ToolTip="dd/mm/aaaa" />
                            <TextBlock Text="Motivo (opcional)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="AdvanceConceptTextBox" Style="{StaticResource FieldBox}" MaxLength="200" AutomationProperties.Name="Motivo"
                                     ToolTip="Ej.: a cuenta del sueldo de octubre" />
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource ActionGroupSpacing}">
                                <Button x:Name="AdvanceSaveButton" Content="Registrar adelanto" Margin="{StaticResource ActionSpacing}" Click="AdvanceSaveButton_Click" />
                                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Click="CancelEditorButton_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- employee-lifecycle E2: the employee's overtime. Recorded when worked; the next payroll takes the pending ones. -->
                        <Grid x:Name="OvertimePanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Se cargan cuando se trabajan: horas × el valor de la hora extra × el multiplicador. La próxima liquidación toma las pendientes sola."
                                           Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock x:Name="OvertimeNoRateText" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="Cargá el valor de la hora extra en los datos del empleado («Editar») para poder registrar horas extra." />
                                <StackPanel x:Name="OvertimeFormPanel">
                                    <TextBlock x:Name="OvertimeRateText" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,8" />
                                    <UniformGrid Columns="3" Style="{StaticResource FormRow}">
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Fecha" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="OvertimeDateTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Fecha" ToolTip="dd/mm/aaaa"
                                                     TextChanged="OvertimeDateTextBox_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Horas" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="OvertimeHoursTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Horas" ToolTip="Ej.: 2,5"
                                                     TextChanged="OvertimeInput_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FormCell}">
                                            <TextBlock Text="Multiplicador" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="OvertimeMultiplierTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Multiplicador"
                                                     TextChanged="OvertimeMultiplierTextBox_TextChanged" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="El domingo se propone ×2; cualquier otro día, ×1. Se puede cambiar (de 1 a 3)." Style="{StaticResource FieldHint}" />
                                    <TextBlock Text="Nota (opcional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="OvertimeNoteTextBox" Style="{StaticResource FieldBox}" MaxLength="200" AutomationProperties.Name="Nota"
                                             ToolTip="Ej.: inventario" />
                                    <TextBlock x:Name="OvertimePreviewText" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    <Button x:Name="OvertimeSaveButton" Content="Registrar horas extra" HorizontalAlignment="Left"
                                            Margin="{StaticResource ActionGroupSpacing}" Click="OvertimeSaveButton_Click" />
                                </StackPanel>
                                <TextBlock Text="Cargadas" Style="{StaticResource FormSectionTitle}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="OvertimeItemsControl" AutomationProperties.Name="Horas extra cargadas">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SoftCardBorder}" Padding="12,8" Margin="0,0,12,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextBlock}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                                                    <Button Grid.Column="2" Content="Borrar" Style="{StaticResource GhostButton}" Tag="{Binding Id}"
                                                            Visibility="{Binding DeleteVisibility}" AutomationProperties.Name="{Binding DeleteLabel}"
                                                            Click="OvertimeDeleteButton_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2">
                                <TextBlock x:Name="OvertimeEmptyText" Text="No tiene horas extra cargadas." Style="{StaticResource MutedTextBlock}" Visibility="Collapsed" />
                                <!-- Deleting asks first, as the web's dialog does. -->
                                <Border x:Name="OvertimeConfirmPanel" Style="{StaticResource SoftCardBorder}" Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="OvertimeConfirmText" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource ActionGroupSpacing}">
                                            <Button Content="Borrar" Margin="{StaticResource ActionSpacing}" Click="OvertimeConfirmDeleteButton_Click" />
                                            <Button Content="Cancelar" Style="{StaticResource GhostButton}" Click="OvertimeCancelDeleteButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Button Content="Cerrar" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="{StaticResource ActionGroupSpacing}"
                                        Click="CancelEditorButton_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- employee-lifecycle E3: "Gestionar baja": the leave with its date and reason, or, once given, the reinstatement.
                             The last salary is settled in the web (the payroll is web only). -->
                        <StackPanel x:Name="LeavePanel" Visibility="Collapsed">
                            <TextBlock Text="La baja se registra con su fecha y su motivo. Después se liquida el último sueldo con el mismo flujo de «Sueldos»."
                                       Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <StackPanel x:Name="LeaveFormPanel">
                                <TextBlock Text="Fecha de baja" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LeaveDateTextBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Fecha de baja" ToolTip="dd/mm/aaaa" />
                                <TextBlock Text="Motivo" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LeaveReasonTextBox" Style="{StaticResource FieldBox}" MaxLength="500" AutomationProperties.Name="Motivo"
                                         ToolTip="Ej.: renuncia" />
                                <StackPanel Orientation="Horizontal" Margin="{StaticResource ActionGroupSpacing}">
                                    <Button x:Name="LeaveSaveButton" Content="Dar de baja" Margin="{StaticResource ActionSpacing}" Click="LeaveSaveButton_Click" />
                                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Click="CancelEditorButton_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="LeftPanel" Visibility="Collapsed">
                                <TextBlock x:Name="LeaveStatusText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="El último sueldo se liquida en la web («Personal» → «Gestionar baja» → «Liquidar último sueldo»): propone el sueldo proporcional a los días trabajados, las horas extra pendientes, los adelantos y la mercadería."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <TextBlock Text="Si vuelve a trabajar, reincorporalo: se borran la fecha y el motivo de la baja." Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="{StaticResource ActionGroupSpacing}">
                                    <Button x:Name="ReinstateButton" Content="Reincorporar" Margin="{StaticResource ActionSpacing}" Click="ReinstateButton_Click" />
                                    <Button Content="Cerrar" Style="{StaticResource GhostButton}" Click="CancelEditorButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- The employee's account, read-only here: manual movements are registered in the web (accounting). -->
                        <Grid x:Name="AccountPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Saldo" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="AccountBalanceText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" AutomationProperties.Name="Saldo" />
                                <TextBlock Text="Positivo: le debemos (sueldo pendiente). Negativo: nos debe (adelantos, compras)." Style="{StaticResource FieldHint}" Margin="0,0,0,10" />
                                <TextBlock Text="Movimientos" Style="{StaticResource FormSectionTitle}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="MovementsItemsControl" AutomationProperties.Name="Movimientos">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SoftCardBorder}" Padding="12,8" Margin="0,0,12,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Concept}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextBlock}" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Amount}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Balance}" HorizontalAlignment="Right" Style="{StaticResource MutedTextBlock}" FontSize="12" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2">
                                <TextBlock x:Name="MovementsEmptyText" Text="No hay movimientos." Style="{StaticResource MutedTextBlock}" Visibility="Collapsed" />
                                <TextBlock Text="Los movimientos manuales y las anulaciones se registran en la web (Personal → Cuenta)." Style="{StaticResource FieldHint}" Margin="0,8,0,0" />
                                <Button Content="Cerrar" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="{StaticResource ActionGroupSpacing}"
                                        Click="CancelEditorButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:EntityListView.EditorContent>
            </controls:EntityListView>
        </Grid>
    </Grid>
</UserControl>
