<Window x:Class="Commerce.Pos.Windows.TenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobro" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="COBRO" Style="{StaticResource EyebrowTextBlock}" />
                <TextBlock x:Name="HeadingText" Text="Cobro" Style="{StaticResource HeroTextBlock}" FontSize="22" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                    <TextBlock Text="TOTAL" FontSize="14" FontWeight="SemiBold" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="TotalText" Text="$0.00" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Cash: the amount received, the exact-amount fill and the change to hand back. -->
                <StackPanel x:Name="CashPanel">
                    <TextBlock Text="Importe recibido" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AmountReceivedTextBox" FontSize="20" TextChanged="AmountReceivedTextBox_TextChanged"
                                 KeyDown="AmountReceivedTextBox_KeyDown" AutomationProperties.Name="Importe recibido" />
                        <Button x:Name="ExactButton" Grid.Column="1" Content="Exacto" Margin="8,0,0,0" Padding="16,0"
                                Style="{StaticResource SecondaryButton}" Click="ExactButton_Click" AutomationProperties.Name="Importe exacto" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Vuelto" FontSize="16" FontWeight="SemiBold" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ChangeText" Grid.Column="1" Text="—" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                    </Grid>
                </StackPanel>

                <!-- Card / QR: the charge happens on the merchant's own terminal or app; the POS only records it. -->
                <TextBlock x:Name="InstructionText" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

                <Border x:Name="MessageBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <Button x:Name="ConfirmButton" Content="Confirmar cobro" HorizontalAlignment="Stretch" Click="ConfirmButton_Click" />
                <Button x:Name="CancelButton" Content="Cancelar" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                        Style="{StaticResource GhostButton}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
