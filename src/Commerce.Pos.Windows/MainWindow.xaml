<Window x:Class="Commerce.Pos.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commerce Pos.Windows" Height="620" Width="640">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Terminal Identity" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                <TextBlock x:Name="IdentityText" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RepairButton" Content="Re-pair terminal" VerticalAlignment="Top" Margin="24,0,0,0" Click="RepairButton_Click" />
            <Button x:Name="SwitchOperatorButton" Content="Switch operator" VerticalAlignment="Top" Margin="8,0,0,0" Click="SwitchOperatorButton_Click" />
            <Button x:Name="ManageCustomersButton" Content="Manage customers" VerticalAlignment="Top" Margin="8,0,0,0" Click="ManageCustomersButton_Click" Visibility="Collapsed" />
        </StackPanel>

        <TextBlock Text="Branch Status" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <!-- Task 7.7: ADR-002's existing freshness policy (CachedOperator.Ttl,
             14 days), read off the catalog-prices sync cursor age. No new
             freshness mechanism is introduced. A stale cache never blocks a
             sale (ADR-002: the branch stays authoritative for its own sale) —
             it is only made visible. -->
        <Border x:Name="StaleCatalogBanner" Background="#FFF3CD" BorderBrush="#FFECB5" BorderThickness="1"
                Padding="8" Margin="0,0,0,16" Visibility="Collapsed">
            <TextBlock x:Name="StaleCatalogBannerText" TextWrapping="Wrap" Foreground="#664D03" />
        </Border>

        <!-- Task 7.4/7.5: scan is the PRIMARY flow, above a visual separator
             from the demoted manual fallback (design.md "POS: two explicit
             buttons, not a mode toggle"). -->
        <TextBlock Text="Scan Item" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Code:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ScanCodeTextBox" Width="220" KeyDown="ScanCodeTextBox_KeyDown" />
        </StackPanel>
        <TextBlock x:Name="ScanMessageText" TextWrapping="Wrap" Foreground="#B00020" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Item" FontWeight="Bold" Width="220" />
            <TextBlock Text="Qty" FontWeight="Bold" Width="60" />
            <TextBlock Text="Unit Price" FontWeight="Bold" Width="100" />
            <TextBlock Text="Line Total" FontWeight="Bold" Width="100" />
        </StackPanel>
        <ListView x:Name="ScannedLinesListView" Height="140" Margin="0,0,0,8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}" Width="220" />
                        <TextBlock Text="{Binding QuantityText}" Width="60" />
                        <TextBlock Text="{Binding UnitPriceText}" Width="100" />
                        <TextBlock Text="{Binding LineTotalText}" Width="100" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Scanned Total:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="ScannedTotalText" Text="$0.00" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="CommitScannedSaleButton" Content="Commit scanned sale" Click="CommitScannedSaleButton_Click" />
        </StackPanel>

        <Separator Margin="0,0,0,16" />

        <!-- Task 7.5: demoted fallback group, kept per the locked proposal
             decision, clearly labelled and visually separated from the scan
             flow above. -->
        <TextBlock Text="Miscellaneous / No Barcode (fallback)" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Amount:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="AmountTextBox" Width="120" Text="19.99" />
            <TextBlock Text="Customer:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox x:Name="CustomerPickerComboBox" Width="160" DisplayMemberPath="Label" />
            <Button x:Name="CommitSaleButton" Content="Commit manual sale" Margin="16,0,0,0" Click="CommitSaleButton_Click" />
        </StackPanel>
        <TextBlock x:Name="SaleResultText" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Text="Sync to Cloud.Api" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <Button x:Name="SyncButton" Content="Sync Pending Outbox" HorizontalAlignment="Left" Click="SyncButton_Click" />
        <TextBlock x:Name="SyncResultText" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
    </ScrollViewer>
</Window>
