<Window x:Class="Commerce.Pos.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Commerce.Pos.Windows.Controls"
        Title="Commerce Pos.Windows" Height="760" Width="1180" MinHeight="700" MinWidth="1120" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PosNavBar x:Name="NavBar" Grid.Row="0"
                            CustomersRequested="ManageCustomersButton_Click"
                            StaffRequested="ManageStaffButton_Click"
                            SyncRequested="SyncButton_Click"
                            SettingsRequested="RepairButton_Click"
                            SwitchOperatorRequested="SwitchOperatorButton_Click" />

        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="StaleCatalogBanner" Grid.Row="0" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                    Padding="12,8" Margin="0,0,0,10" CornerRadius="10" Visibility="Collapsed">
                <TextBlock x:Name="StaleCatalogBannerText" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
            </Border>

            <!-- Scan / search box, full width, with the manual-amount sale as a secondary action. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="ScanCodeTextBox" FontSize="20" MinHeight="52" Padding="46,8,12,8" VerticalContentAlignment="Center"
                             KeyDown="ScanCodeTextBox_KeyDown" TextChanged="ScanCodeTextBox_TextChanged" AutomationProperties.Name="Escanear o buscar producto" />
                    <TextBlock Text="{StaticResource IconSearch}" Style="{StaticResource IconTextBlock}" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Left" Margin="16,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Escanear o buscar producto…" FontSize="20" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="47,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ScanCodeTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button x:Name="ManualSaleButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" MinHeight="52" Padding="16,0"
                        Click="ManualSaleButton_Click" ToolTip="Registrar una venta por un importe sin código de producto" AutomationProperties.Name="Venta manual">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconEdit}" Style="{StaticResource IconTextBlock}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0" />
                        <TextBlock Text="Venta manual" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Popup x:Name="ManualSalePopup" PlacementTarget="{Binding ElementName=ManualSaleButton}" Placement="Bottom" HorizontalOffset="-160"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Style="{StaticResource CardBorder}" Padding="16" CornerRadius="12" Margin="8">
                        <StackPanel Width="300">
                            <TextBlock Text="Venta manual" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Para artículos sin código en el catálogo local. No se puede combinar con productos de la venta actual."
                                       Style="{StaticResource MutedTextBlock}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <TextBlock Text="Importe" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,6" />
                            <TextBox x:Name="AmountTextBox" Text="19.99" />
                            <TextBlock Text="Cobrar con" Style="{StaticResource MutedTextBlock}" Margin="0,12,0,6" />
                            <UniformGrid Rows="1">
                                <Button x:Name="CommitSaleButton" Content="Efectivo" Tag="cash" Margin="0,0,6,0" Click="CommitSaleButton_Click" AutomationProperties.Name="Cobrar venta manual en efectivo" />
                                <Button x:Name="ManualCardButton" Content="Tarjeta" Tag="card" Margin="0,0,6,0" Click="CommitSaleButton_Click" AutomationProperties.Name="Cobrar venta manual con tarjeta" />
                                <Button x:Name="ManualQrButton" Content="QR" Tag="qr" Click="CommitSaleButton_Click" AutomationProperties.Name="Cobrar venta manual con QR" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,2,0,2">
                <TextBlock x:Name="ScanMessageText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                <TextBlock x:Name="SaleResultText" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" />
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="260" />
                    <ColumnDefinition Width="3*" MinWidth="460" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Products from the local catalog -->
                <Grid Grid.Column="0" Margin="0,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Productos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CatalogCardsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:ProductCard IncrementRequested="ProductCard_IncrementRequested" DecrementRequested="ProductCard_DecrementRequested" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="CatalogEmptyText" Grid.Row="1" Text="No hay productos en el catálogo de esta terminal. Sincronice para descargarlos."
                               Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12" Visibility="Collapsed" />
                    <TextBlock x:Name="CatalogTruncatedText" Grid.Row="2" Style="{StaticResource MutedTextBlock}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Se muestran los primeros resultados. Refine la búsqueda o elija una categoría." Visibility="Collapsed" />
                </Grid>

                <!-- Current sale: table and totals -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Venta actual" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Cliente" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CustomerPickerComboBox" DisplayMemberPath="Label" MinWidth="190" MaxWidth="240" />
                        </StackPanel>
                    </Grid>
                    <controls:SaleLinesTable x:Name="SaleTable" Grid.Row="1" QuantityEdited="SaleTable_QuantityEdited" LineRemoved="SaleTable_LineRemoved" LineDiscountRequested="SaleTable_LineDiscountRequested" />
                    <controls:TotalsPanel x:Name="TotalsPanelControl" Grid.Row="2" Margin="0,10,0,0" TenderRequested="CommitScannedSaleButton_Click" SaleDiscountRequested="TotalsPanel_SaleDiscountRequested" />
                </Grid>

                <controls:CategoryRail x:Name="CategoryRailControl" CategorySelected="CategoryRail_CategorySelected" Grid.Column="2" Width="104" Margin="14,26,0,0" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource ShellElevatedBrush}" BorderBrush="{DynamicResource BorderBrushMuted}" BorderThickness="0,1,0,0" Padding="16,4">
            <Grid MinHeight="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BottomSyncStatusText" Grid.Column="0" Style="{StaticResource MutedTextBlock}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="BottomVersionStatusText" Grid.Column="1" Style="{StaticResource MutedTextBlock}" FontSize="12" VerticalAlignment="Center" Margin="18,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
