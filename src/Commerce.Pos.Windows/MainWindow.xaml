<Window x:Class="Commerce.Pos.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commerce Pos.Windows" Height="420" Width="560">
    <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Terminal Identity" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                <TextBlock x:Name="IdentityText" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RepairButton" Content="Re-pair terminal" VerticalAlignment="Top" Margin="24,0,0,0" Click="RepairButton_Click" />
            <Button x:Name="SwitchOperatorButton" Content="Switch operator" VerticalAlignment="Top" Margin="8,0,0,0" Click="SwitchOperatorButton_Click" />
        </StackPanel>

        <TextBlock Text="Branch Status" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Text="Commit Offline Sale" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Amount:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="AmountTextBox" Width="120" Text="19.99" />
            <Button x:Name="CommitSaleButton" Content="Commit Sale" Margin="16,0,0,0" Click="CommitSaleButton_Click" />
        </StackPanel>
        <TextBlock x:Name="SaleResultText" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Text="Sync to Cloud.Api" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <Button x:Name="SyncButton" Content="Sync Pending Outbox" HorizontalAlignment="Left" Click="SyncButton_Click" />
        <TextBlock x:Name="SyncResultText" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
</Window>
