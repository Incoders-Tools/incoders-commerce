<Window x:Class="Commerce.Pos.Windows.OperatorLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator Login" Height="480" Width="420" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Operator login" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />

        <StackPanel x:Name="OperatorPickerPanel" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="Select an operator:" Margin="0,0,0,4" />
            <ListBox x:Name="OperatorListBox" Height="80" DisplayMemberPath="Email" />

            <TextBlock Text="PIN:" Margin="0,8,0,4" />
            <PasswordBox x:Name="PinBox" Margin="0,0,0,8" />

            <Button x:Name="LoginButton" Content="Log in" HorizontalAlignment="Left" Click="LoginButton_Click" />
        </StackPanel>

        <Button x:Name="AddOperatorToggleButton" Content="Add another operator" HorizontalAlignment="Left" Margin="0,0,0,8" Click="AddOperatorToggleButton_Click" />

        <StackPanel x:Name="AddOperatorPanel" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="Email:" Margin="0,0,0,4" />
            <TextBox x:Name="EmailTextBox" Margin="0,0,0,8" />

            <TextBlock Text="Password:" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" />

            <TextBlock Text="Choose a PIN (6 digits):" Margin="0,0,0,4" />
            <PasswordBox x:Name="NewPinBox" Margin="0,0,0,8" />

            <TextBlock Text="Confirm PIN:" Margin="0,0,0,4" />
            <PasswordBox x:Name="ConfirmPinBox" Margin="0,0,0,8" />

            <Button x:Name="ProvisionButton" Content="Provision" HorizontalAlignment="Left" Click="ProvisionButton_Click" />
        </StackPanel>

        <Button x:Name="ContinueWithoutOperatorButton" Content="Continue without operator" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ContinueWithoutOperatorButton_Click" />

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="DarkRed" />
    </StackPanel>
</Window>
