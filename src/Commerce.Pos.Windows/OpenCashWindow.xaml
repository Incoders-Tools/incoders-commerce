<Window x:Class="Commerce.Pos.Windows.OpenCashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Abrir caja" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="CAJA" Style="{StaticResource EyebrowTextBlock}" />
                <TextBlock Text="Abrir caja" Style="{StaticResource HeroTextBlock}" FontSize="22" />
                <TextBlock Text="Ingrese el efectivo con el que comienza la caja. Las ventas quedan registradas en esta caja hasta cerrarla."
                           Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,6,0,14" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="OPERADOR" FontSize="13" FontWeight="SemiBold" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="OperatorText" Text="Sin operador activo" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                </StackPanel>

                <TextBlock Text="Efectivo inicial" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <TextBox x:Name="OpeningFloatTextBox" FontSize="20" Text="0" Margin="0,0,0,10" TextChanged="OpeningFloatTextBox_TextChanged"
                         KeyDown="OpeningFloatTextBox_KeyDown" AutomationProperties.Name="Efectivo inicial" />

                <Border x:Name="MessageBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <Button x:Name="ConfirmButton" Content="Abrir caja" HorizontalAlignment="Stretch" Click="ConfirmButton_Click" />
                <Button x:Name="CancelButton" Content="Ahora no" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                        Style="{StaticResource GhostButton}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
