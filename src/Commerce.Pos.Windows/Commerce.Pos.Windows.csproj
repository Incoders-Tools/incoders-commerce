<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- Device token at rest (design.md "Device token at rest on the
         terminal") uses System.Security.Cryptography.ProtectedData, a
         thin, first-party Microsoft wrapper over the Windows DPAPI syscall,
         no hand-rolled crypto, key derived by the OS from the current
         Windows user's credentials. No explicit PackageReference is needed:
         under net10.0-windows/UseWPF, this assembly ships as part of the
         Windows Desktop shared framework (confirmed: an explicit reference
         here produced an NU1510 "will not be pruned" warning, and removing
         it builds/tests identically). -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Commerce.Domain\Commerce.Domain.csproj" />
    <ProjectReference Include="..\Commerce.Application\Commerce.Application.csproj" />
    <ProjectReference Include="..\Commerce.BranchNode\Commerce.BranchNode.csproj" />
  </ItemGroup>

</Project>
