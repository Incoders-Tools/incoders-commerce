<UserControl x:Class="Commerce.Pos.Windows.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Commerce.Pos.Windows.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="PERSONAL" Style="{StaticResource EyebrowTextBlock}" />
            <TextBlock Text="Personal" Style="{StaticResource HeroTextBlock}" FontSize="24" />
        </StackPanel>

        <!-- Outside the scroll area on purpose: an error must stay visible however far the section is scrolled. -->
        <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource DangerBrush}"
                   Visibility="Collapsed" AutomationProperties.Name="Estado" />

        <StackPanel x:Name="BusyPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,8">
            <ProgressBar x:Name="BusyProgressBar" IsIndeterminate="True" Height="6" BorderThickness="0"
                         Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderBrushMuted}" />
            <TextBlock x:Name="BusyText" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" />
        </StackPanel>

        <Grid x:Name="FormPanel" Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,12" MaxWidth="900" HorizontalAlignment="Left">

                    <!-- Admin confirmation: server authorization for the staff calls, asked inline instead of a modal. -->
                    <controls:AdminSignInPanel x:Name="SignInPanel" Margin="0,0,0,16" />

                    <StackPanel x:Name="ServerPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Nuevo usuario" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Se crea en la sucursal de esta terminal. La persona crea su PIN la primera vez que ingresa en una terminal, con su correo y contraseña."
                                           Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                <TextBlock Text="Correo" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="NewEmailTextBox" Margin="0,0,0,10" MaxWidth="420" HorizontalAlignment="Left" Width="420" />
                                <TextBlock Text="Contraseña inicial" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,10" MaxWidth="420" HorizontalAlignment="Left" Width="420" />
                                <TextBlock Text="Rol" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="RoleComboBox" DisplayMemberPath="Label" SelectedValuePath="Name" Margin="0,0,0,14"
                                          MaxWidth="420" HorizontalAlignment="Left" Width="420" />
                                <Button x:Name="CreateButton" Content="Crear usuario" HorizontalAlignment="Left" Click="CreateButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ResetPanel" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ResetTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <PasswordBox x:Name="ResetPasswordBox" Margin="0,10,0,12" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                             AutomationProperties.Name="Nueva contraseña" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ResetSaveButton" Content="Restablecer contraseña" Click="ResetSaveButton_Click" />
                                    <Button x:Name="ResetCancelButton" Content="Cancelar" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ResetCancelButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Personal" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl x:Name="StaffItemsControl" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SoftCardBorder}" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Email}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding RolesText}" Style="{StaticResource MutedTextBlock}" FontSize="12" />
                                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedTextBlock}" FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Restablecer contraseña" Tag="{Binding UserId}" Style="{StaticResource GhostButton}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Visibility="{Binding CanResetPassword, Converter={StaticResource BoolToVisibility}}"
                                                    Click="ResetPasswordRowButton_Click" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding ShowAction, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="{Binding ActionLabel}" Tag="{Binding UserId}" Style="{StaticResource SecondaryButton}"
                                                        Click="StatusActionButton_Click" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding ConfirmText}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                                                <Button Content="Confirmar" Tag="{Binding UserId}" Margin="0,0,8,0" Click="ConfirmStatusButton_Click" />
                                                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Click="CancelStatusButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="StaffEmptyText" Text="Todavía no hay personal cargado." Style="{StaticResource MutedTextBlock}"
                                   Visibility="Collapsed" Margin="0,0,0,16" />
                    </StackPanel>

                    <!-- Local to this terminal: no server call, so it is available before the confirmation too. -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Operadores de esta terminal" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Quienes pueden ingresar con su PIN en esta terminal. Para sumar a alguien nuevo, cerrá tu sesión: esa persona ingresa con su correo y contraseña desde la pantalla de ingreso."
                                       Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <ItemsControl x:Name="OperatorsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SoftCardBorder}" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Email}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextBlock}" FontSize="12" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Quitar de esta terminal" Tag="{Binding UserId}" Style="{StaticResource SecondaryButton}"
                                                        VerticalAlignment="Center" Visibility="{Binding ShowAction, Converter={StaticResource BoolToVisibility}}"
                                                        Click="RemoveOperatorButton_Click" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                                                    <Button Content="Quitar" Tag="{Binding UserId}" Margin="0,0,8,0" Click="ConfirmRemoveOperatorButton_Click" />
                                                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Click="CancelRemoveOperatorButton_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="OperatorsEmptyText" Text="Todavía no hay operadores en esta terminal." Style="{StaticResource MutedTextBlock}"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="OperatorConfirmText" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
