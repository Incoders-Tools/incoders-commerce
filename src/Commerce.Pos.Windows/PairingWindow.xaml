<Window x:Class="Commerce.Pos.Windows.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Terminal" Height="420" Width="420" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Sign in to pair this terminal" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />

        <TextBlock Text="Email:" Margin="0,0,0,4" />
        <TextBox x:Name="EmailTextBox" Margin="0,0,0,8" />

        <TextBlock Text="Password:" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" />

        <Button x:Name="SignInButton" Content="Sign in" HorizontalAlignment="Left" Click="SignInButton_Click" />

        <StackPanel x:Name="BranchSelectionPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock Text="Select a branch:" FontWeight="Bold" Margin="0,0,0,8" />
            <ListBox x:Name="BranchListBox" Height="100" DisplayMemberPath="Name" />
            <Button x:Name="PairButton" Content="Pair" Margin="0,8,0,0" HorizontalAlignment="Left" Click="PairButton_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="DarkRed" />
    </StackPanel>
</Window>
