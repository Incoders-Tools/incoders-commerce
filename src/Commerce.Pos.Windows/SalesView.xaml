<UserControl x:Class="Commerce.Pos.Windows.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, the day shown (previous / today / next) and the search. -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="VENTAS" Style="{StaticResource EyebrowTextBlock}" />
                <TextBlock Text="Ventas, cobros y caja" Style="{StaticResource HeroTextBlock}" FontSize="22" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextBlock}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="PreviousDayButton" Style="{StaticResource SecondaryButton}" Content="‹ Día anterior" Padding="12,0" MinHeight="38"
                        Click="PreviousDayButton_Click" AutomationProperties.Name="Día anterior" />
                <Border Style="{StaticResource CardBorder}" Padding="14,0" Margin="8,0" MinHeight="38" CornerRadius="10">
                    <TextBlock x:Name="DayText" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="150" TextAlignment="Center" />
                </Border>
                <Button x:Name="NextDayButton" Style="{StaticResource SecondaryButton}" Content="Día siguiente ›" Padding="12,0" MinHeight="38"
                        Click="NextDayButton_Click" AutomationProperties.Name="Día siguiente" />
                <Button x:Name="TodayButton" Style="{StaticResource GhostButton}" Content="Hoy" Padding="12,0" MinHeight="38" Margin="8,0,0,0"
                        Click="TodayButton_Click" AutomationProperties.Name="Ver las ventas de hoy" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="SearchTextBox" Padding="28,8,12,8" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"
                     AutomationProperties.Name="Buscar ventas por número, cliente, medio de pago o importe" />
            <TextBlock Text="{StaticResource IconSearch}" Style="{StaticResource IconTextBlock}" FontSize="14" Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
            <!-- Same template, padding and font as the search box, so the placeholder starts where the caret does. -->
            <TextBox x:Name="SearchPlaceholderText" Text="Buscar por número, cliente, medio de pago o importe…" Padding="28,8,12,8" VerticalContentAlignment="Center"
                     IsHitTestVisible="False" Focusable="False" IsTabStop="False" IsReadOnly="True"
                     Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>

        <TextBlock x:Name="StatusMessageText" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentTextBrush}" Visibility="Collapsed" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- The day's sales, newest first. -->
            <Grid Margin="0,0,14,0">
                <ListBox x:Name="SalesListBox" SelectionChanged="SalesListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Ventas del día">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Run Text="{Binding NumberText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding CustomerText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <Run Text="{Binding TenderText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding KindText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding TotalText}" FontWeight="Bold" FontSize="15" TextAlignment="Right"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border CornerRadius="6" Padding="6,1" Margin="0,3,0,0" HorizontalAlignment="Right"
                                            Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Anulada" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="16" Visibility="Collapsed" />
            </Grid>

            <!-- Detail of the selected sale. -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="18">
                <Grid>
                    <TextBlock x:Name="NoSelectionText" Text="Elija una venta para ver su detalle." Style="{StaticResource MutedTextBlock}"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DetailNumberText" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailWhenText" Style="{StaticResource MutedTextBlock}" Margin="0,2,0,0" />
                            <TextBlock x:Name="DetailCustomerText" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailTenderText" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailDiscountText" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            <TextBlock Text="Productos" Style="{StaticResource MutedTextBlock}" FontWeight="SemiBold" Margin="0,14,0,6" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DetailLinesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="Total" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="DetailTotalText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Border x:Name="VoidInfoBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="VoidInfoText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                            <TextBlock x:Name="VoidUnavailableText" Style="{StaticResource MutedTextBlock}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,12,0,0" Visibility="Collapsed" />
                            <Button x:Name="VoidButton" Content="Anular venta" HorizontalAlignment="Stretch" Margin="0,12,0,0" MinHeight="44"
                                    Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    Click="VoidButton_Click" Visibility="Collapsed" AutomationProperties.Name="Anular la venta elegida" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
