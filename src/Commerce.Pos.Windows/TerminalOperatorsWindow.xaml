<Window x:Class="Commerce.Pos.Windows.TerminalOperatorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operadores de esta terminal" Height="610" Width="520" WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="PERSONAL" Style="{StaticResource EyebrowTextBlock}" />
                    <TextBlock Text="Operadores de esta terminal" Style="{StaticResource HeroTextBlock}" />
                    <TextBlock Text="Quienes pueden ingresar con su PIN en esta terminal. Agregá un operador con su correo y contraseña."
                               Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource SoftCardBorder}" Padding="10" Margin="0,0,0,10">
                    <ListBox x:Name="OperatorsListBox" Height="190" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Email}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextBlock}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock x:Name="EmptyText" Text="Todavía no hay operadores en esta terminal." Style="{StaticResource MutedTextBlock}"
                           Visibility="Collapsed" Margin="0,0,0,10" />

                <Button x:Name="AddOperatorButton" Content="Agregar operador" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="AddOperatorButton_Click" />
                <Button x:Name="RemoveOperatorButton" Content="Quitar de esta terminal" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Click="RemoveOperatorButton_Click" Style="{StaticResource SecondaryButton}" />
                <Button x:Name="CloseButton" Content="Cerrar" HorizontalAlignment="Stretch" Click="CloseButton_Click" Style="{StaticResource GhostButton}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
