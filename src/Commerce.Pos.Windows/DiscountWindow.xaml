<Window x:Class="Commerce.Pos.Windows.DiscountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descuento" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=PercentTextBox}">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="AUTORIZACIÓN" Style="{StaticResource EyebrowTextBlock}" />
                <TextBlock x:Name="HeadingText" Text="Descuento" Style="{StaticResource HeroTextBlock}" FontSize="22" />
                <TextBlock x:Name="SubjectText" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,2,0,14" />

                <TextBlock Text="Porcentaje de descuento" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <TextBox x:Name="PercentTextBox" Margin="0,0,0,10" KeyDown="Input_KeyDown" AutomationProperties.Name="Porcentaje de descuento" />

                <TextBlock Text="PIN de descuentos" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <PasswordBox x:Name="PinBox" Margin="0,0,0,10" KeyDown="Input_KeyDown" AutomationProperties.Name="PIN de descuentos" />

                <Border x:Name="MessageBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <Button x:Name="ApplyButton" Content="Aplicar descuento" HorizontalAlignment="Stretch" Click="ApplyButton_Click" />
                <Button x:Name="RemoveDiscountButton" Content="Quitar descuento" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                        Style="{StaticResource SecondaryButton}" Click="RemoveDiscountButton_Click" Visibility="Collapsed" />
                <Button x:Name="CancelButton" Content="Cancelar" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                        Style="{StaticResource GhostButton}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
