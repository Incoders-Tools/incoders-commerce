<Window x:Class="Commerce.Pos.Windows.CustomerPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobro de cuenta corriente" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=AmountTextBox}">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="CUENTA CORRIENTE" Style="{StaticResource EyebrowTextBlock}" />
                <TextBlock Text="Cobro de cuenta corriente" Style="{StaticResource HeroTextBlock}" FontSize="22" />
                <TextBlock x:Name="CustomerText" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />

                <!-- What the customer owes, as this terminal knows it. -->
                <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="10" Padding="12" Margin="0,12,0,14">
                    <StackPanel>
                        <TextBlock x:Name="BalanceHeadlineText" FontSize="20" FontWeight="Bold" />
                        <TextBlock x:Name="BalanceDetailText" Style="{StaticResource MutedTextBlock}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Importe a cobrar" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <TextBox x:Name="AmountTextBox" FontSize="20" Margin="0,0,0,12" TextChanged="Input_Changed" KeyDown="Input_KeyDown"
                         AutomationProperties.Name="Importe a cobrar" />

                <TextBlock Text="Cómo paga" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <UniformGrid Rows="1" Margin="0,0,0,12">
                    <UniformGrid.Resources>
                        <Style TargetType="RadioButton" BasedOn="{StaticResource AppearanceThemeOption}" />
                    </UniformGrid.Resources>
                    <RadioButton x:Name="CashRadio" Content="Efectivo" GroupName="Method" IsChecked="True" Checked="Method_Checked" Margin="0,0,8,0"
                                 AutomationProperties.Name="Paga en efectivo" />
                    <RadioButton x:Name="CardRadio" Content="Tarjeta" GroupName="Method" Checked="Method_Checked" Margin="0,0,8,0"
                                 AutomationProperties.Name="Paga con tarjeta" />
                    <RadioButton x:Name="QrRadio" Content="QR" GroupName="Method" Checked="Method_Checked" AutomationProperties.Name="Paga con QR" />
                </UniformGrid>

                <StackPanel x:Name="CashPanel">
                    <TextBlock Text="Recibido" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReceivedTextBox" FontSize="18" TextChanged="Input_Changed" KeyDown="Input_KeyDown"
                                 AutomationProperties.Name="Importe recibido" />
                        <Button Grid.Column="1" Content="Exacto" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,0"
                                Click="ExactButton_Click" AutomationProperties.Name="Recibido igual al importe" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Vuelto" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ChangeText" Text="—" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="Nota (opcional)" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <TextBox x:Name="NoteTextBox" MaxLength="200" Margin="0,0,0,12" AutomationProperties.Name="Nota del cobro" />

                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="El cobro baja la deuda del cliente, entra en la caja de hoy (si es en efectivo, suma al efectivo esperado) y en la tesorería de la sucursal al sincronizar." />

                <Border x:Name="MessageBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <Button x:Name="ConfirmButton" Content="Registrar cobro" HorizontalAlignment="Stretch" Click="ConfirmButton_Click" IsEnabled="False" />
                <Button Content="Cancelar" HorizontalAlignment="Stretch" Margin="0,8,0,0" Style="{StaticResource GhostButton}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
