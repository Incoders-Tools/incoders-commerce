<Window x:Class="Commerce.Pos.Windows.VoidSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anular venta" Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=ReasonTextBox}">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="AUTORIZACIÓN" Style="{StaticResource EyebrowTextBlock}" />
                <TextBlock x:Name="HeadingText" Text="Anular venta" Style="{StaticResource HeroTextBlock}" FontSize="22" />
                <TextBlock x:Name="SubjectText" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,2,0,14" />

                <TextBlock Text="Motivo" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <TextBox x:Name="ReasonTextBox" Margin="0,0,0,10" MaxLength="200" KeyDown="Input_KeyDown" AutomationProperties.Name="Motivo de la anulación" />

                <TextBlock Text="PIN de autorización" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <PasswordBox x:Name="PinBox" Margin="0,0,0,10" KeyDown="Input_KeyDown" AutomationProperties.Name="PIN de autorización" />

                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Queda registrado como anulado (no se borra) y sale del total de la caja. Al sincronizar se revierten el stock, la tesorería y la cuenta corriente del cliente." />

                <Border x:Name="MessageBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <Button x:Name="VoidButton" Content="Anular venta" HorizontalAlignment="Stretch" Click="VoidButton_Click"
                        Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" />
                <Button x:Name="CancelButton" Content="Cancelar" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                        Style="{StaticResource GhostButton}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
