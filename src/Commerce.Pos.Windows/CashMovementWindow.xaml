<Window x:Class="Commerce.Pos.Windows.CashMovementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimiento de caja" Width="500" SizeToContent="Height" WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=AmountTextBox}">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="CAJA" Style="{StaticResource EyebrowTextBlock}" />
                <TextBlock Text="Movimiento de caja" Style="{StaticResource HeroTextBlock}" FontSize="22" />
                <TextBlock x:Name="ExpectedCashText" Style="{StaticResource MutedTextBlock}" Margin="0,2,0,14" TextWrapping="Wrap" />

                <UniformGrid Rows="1" Margin="0,0,0,12">
                    <UniformGrid.Resources>
                        <Style TargetType="RadioButton" BasedOn="{StaticResource AppearanceThemeOption}" />
                    </UniformGrid.Resources>
                    <RadioButton x:Name="WithdrawalRadio" Content="Retiro (sale dinero)" GroupName="Kind" IsChecked="True" Checked="Kind_Checked"
                                 Margin="0,0,8,0" AutomationProperties.Name="Retiro de dinero de la caja" />
                    <RadioButton x:Name="DepositRadio" Content="Ingreso (entra dinero)" GroupName="Kind" Checked="Kind_Checked"
                                 AutomationProperties.Name="Ingreso de dinero a la caja" />
                </UniformGrid>

                <TextBlock Text="Importe" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <TextBox x:Name="AmountTextBox" FontSize="20" Margin="0,0,0,12" TextChanged="Input_Changed" KeyDown="Input_KeyDown"
                         AutomationProperties.Name="Importe del movimiento" />

                <TextBlock x:Name="CounterpartLabel" Text="¿A dónde va?" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <ComboBox x:Name="CounterpartComboBox" Margin="0,0,0,8" SelectionChanged="Counterpart_SelectionChanged"
                          DisplayMemberPath="Label" AutomationProperties.Name="Destino u origen del dinero" />
                <TextBlock x:Name="ExplanationText" Style="{StaticResource MutedTextBlock}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

                <TextBlock Text="Motivo" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <TextBox x:Name="ReasonTextBox" MaxLength="200" Margin="0,0,0,12" TextChanged="Input_Changed" KeyDown="Input_KeyDown"
                         AutomationProperties.Name="Motivo del movimiento" />

                <StackPanel x:Name="PinPanel">
                    <TextBlock Text="PIN de autorización" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                    <PasswordBox x:Name="PinBox" Margin="0,0,0,6" KeyDown="Input_KeyDown" AutomationProperties.Name="PIN de autorización" />
                    <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Un retiro necesita el PIN de la sucursal, como una anulación." />
                </StackPanel>

                <Border x:Name="MessageBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <Button x:Name="ConfirmButton" Content="Registrar retiro" HorizontalAlignment="Stretch" Click="ConfirmButton_Click" IsEnabled="False" />
                <Button Content="Cancelar" HorizontalAlignment="Stretch" Margin="0,8,0,0" Style="{StaticResource GhostButton}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
