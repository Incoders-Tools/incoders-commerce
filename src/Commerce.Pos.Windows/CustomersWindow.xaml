<Window x:Class="Commerce.Pos.Windows.CustomersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Customers" Height="640" Width="760" WindowStartupLocation="CenterOwner" Icon="app.ico">
    <Grid Margin="16">
        <StackPanel x:Name="SignInPanel">
            <TextBlock Text="Sign in as an administrator" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
            <TextBlock Text="This requires connectivity — no offline write path exists for customer management." TextWrapping="Wrap" Margin="0,0,0,8" />

            <TextBlock Text="Email:" Margin="0,0,0,4" />
            <TextBox x:Name="AdminEmailTextBox" Margin="0,0,0,8" />

            <TextBlock Text="Password:" Margin="0,0,0,4" />
            <PasswordBox x:Name="AdminPasswordBox" Margin="0,0,0,8" />

            <Button x:Name="SignInButton" Content="Sign in" HorizontalAlignment="Left" Click="SignInButton_Click" />

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="DarkRed" />
        </StackPanel>

        <Grid x:Name="ManagementPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Button x:Name="NewCustomerButton" Content="New Customer" DockPanel.Dock="Top" Margin="0,0,0,8" Click="NewCustomerButton_Click" />
                <ListBox x:Name="CustomersListBox" DisplayMemberPath="DisplayName" SelectionChanged="CustomersListBox_SelectionChanged" />
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Customer Kind:" Margin="0,0,0,4" />
                    <ComboBox x:Name="CustomerKindComboBox" Margin="0,0,0,8" />

                    <TextBlock Text="Display Name:" Margin="0,0,0,4" />
                    <TextBox x:Name="DisplayNameTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Legal Name:" Margin="0,0,0,4" />
                    <TextBox x:Name="LegalNameTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Tax Id Type:" Margin="0,0,0,4" />
                    <ComboBox x:Name="TaxIdTypeComboBox" Margin="0,0,0,8" />

                    <TextBlock Text="Tax Id:" Margin="0,0,0,4" />
                    <TextBox x:Name="TaxIdTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Tax Condition:" Margin="0,0,0,4" />
                    <ComboBox x:Name="TaxConditionComboBox" Margin="0,0,0,8" />

                    <TextBlock Text="Phone:" Margin="0,0,0,4" />
                    <TextBox x:Name="PhoneTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Email:" Margin="0,0,0,4" />
                    <TextBox x:Name="EmailTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Address Street:" Margin="0,0,0,4" />
                    <TextBox x:Name="AddressStreetTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Address Number:" Margin="0,0,0,4" />
                    <TextBox x:Name="AddressNumberTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Neighborhood:" Margin="0,0,0,4" />
                    <TextBox x:Name="NeighborhoodTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Locality:" Margin="0,0,0,4" />
                    <TextBox x:Name="LocalityTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Province:" Margin="0,0,0,4" />
                    <TextBox x:Name="ProvinceTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Postal Code:" Margin="0,0,0,4" />
                    <TextBox x:Name="PostalCodeTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Delivery Notes:" Margin="0,0,0,4" />
                    <TextBox x:Name="DeliveryNotesTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Discount Percentage:" Margin="0,0,0,4" />
                    <TextBox x:Name="DiscountPercentageTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Payment Terms:" Margin="0,0,0,4" />
                    <TextBox x:Name="PaymentTermsTextBox" Margin="0,0,0,8" />

                    <TextBlock Text="Notes:" Margin="0,0,0,4" />
                    <TextBox x:Name="NotesTextBox" Margin="0,0,0,8" />

                    <CheckBox x:Name="IsEnabledCheckBox" Content="Enabled" Margin="0,0,0,8" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" />
                        <Button x:Name="CloseButton" Content="Close" Margin="8,0,0,0" Click="CloseButton_Click" />
                    </StackPanel>

                    <TextBlock x:Name="FormStatusText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="DarkRed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
