<Window x:Class="Commerce.Pos.Windows.MeasuredQuantityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kilos" Width="340" SizeToContent="Height" WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=KilosTextBox}">
    <Grid Margin="16">
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="Kilos" Style="{StaticResource HeroTextBlock}" FontSize="22" />
                <TextBlock x:Name="SubjectText" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,2,0,14" />

                <TextBlock x:Name="UnitLabelText" Text="Kilos (hasta 3 decimales)" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,5" />
                <TextBox x:Name="KilosTextBox" FontSize="24" Margin="0,0,0,10" InputScope="Number"
                         PreviewTextInput="KilosTextBox_PreviewTextInput" TextChanged="KilosTextBox_TextChanged"
                         AutomationProperties.Name="Kilos" />

                <Border x:Name="MessageBorder" Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <UniformGrid x:Name="ActionsPanel" Rows="1">
                    <Button x:Name="CancelButton" Content="Cancelar (Esc)" Style="{StaticResource GhostButton}" Margin="{StaticResource ActionSpacing}" IsCancel="True" />
                    <Button x:Name="ConfirmButton" Content="Aceptar (Enter)" IsDefault="True" Click="ConfirmButton_Click" />
                </UniformGrid>

                <!-- T6: a measure above SaleQuantity.ConfirmAboveKilos is confirmed here; "No" (also Esc) returns to the input. -->
                <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                    </Border>
                    <UniformGrid Rows="1">
                        <Button x:Name="NoButton" Content="No, corregir (Esc)" Style="{StaticResource GhostButton}" Margin="{StaticResource ActionSpacing}" Click="NoButton_Click" />
                        <Button x:Name="YesButton" Content="Sí, confirmar" Click="YesButton_Click" />
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
