{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/Commerce.Cloud.Api/**",
      "src/Commerce.Domain/**",
      "src/Commerce.Application/**",
      "src/Commerce.BranchNode/**",
      "src/Commerce.Web/**",
      "src/Commerce.Migrator/**",
      "deploy/db/migrations/**",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["dotnet /app/migrator/Commerce.Migrator.dll"],
    "startCommand": "dotnet Commerce.Cloud.Api.dll",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
