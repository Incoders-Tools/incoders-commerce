# Local development identities. Copy this file to .env and set unique values.
# See deploy/README.md "Local development identities" for what each key means.

# Platform system administrator (is_system_admin; never an organization role).
COMMERCE_DEV_SYSADMIN_EMAIL=
COMMERCE_DEV_SYSADMIN_PASSWORD=

# First organization and its business-admin.
COMMERCE_DEV_ORGANIZATION_NAME=
COMMERCE_DEV_ORGANIZATION_ADMIN_EMAIL=
COMMERCE_DEV_ORGANIZATION_ADMIN_PASSWORD=

# Optional. Defaults to "Ruta 51" if absent (B7: Vaca Verde / Ruta 51 is the
# first supported organization/branch pairing).
COMMERCE_DEV_ORGANIZATION_BRANCH_NAME=Ruta 51
