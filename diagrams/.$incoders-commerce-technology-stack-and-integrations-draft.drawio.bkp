<mxfile host="app.diagrams.net" modified="2026-09-11T00:00:00.000Z" agent="Codex" version="26.0.14" type="device">
  <diagram id="technology-stack-draft" name="Technology Stack — DRAFT">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Incoders Commerce — Recommended Technology Stack and Integrations [DRAFT]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Every named technology/provider is Proposed / To validate: the product documents explicitly state that stack, databases, infrastructure, and integration providers are not yet approved." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1600" height="25" as="geometry"/></mxCell>

        <mxCell id="constraints" value="Confirmed architectural constraints&#xa;• Windows modern x64 local application&#xa;• Local sale, hardware, and printing work offline&#xa;• Multi-branch; three terminals per initial branch&#xa;• Cloud/web/mobile supports remote and online capabilities&#xa;• Modular, reusable commerce core; butchery is an enabled module" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="340" height="180" as="geometry"/></mxCell>

        <mxCell id="localstack" value="Proposed local stack — validate through ADR&#xa;Windows desktop clients: .NET LTS + WPF or WinUI 3&#xa;Branch node service: .NET LTS / ASP.NET Core&#xa;Domain: modular monolith / clean boundaries&#xa;Local data: SQLite OR local server DB (benchmark concurrency/recovery)&#xa;Sync: durable outbox + versioned idempotent contracts&#xa;Installer/updater: signed Windows packages + channel manifests" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="105" width="500" height="420" as="geometry"/></mxCell>
        <mxCell id="desktop" value="Desktop UI&#xa;Proposed: .NET LTS + WPF or WinUI 3&#xa;Validate: fast POS UX, printer/scale support, deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="localstack"><mxGeometry x="30" y="60" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="node" value="Branch node&#xa;Proposed: ASP.NET Core service&#xa;Owns local API, rules, sync, diagnostics and updates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="localstack"><mxGeometry x="260" y="60" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="localdata" value="Local storage&#xa;Proposed alternatives: SQLite / local PostgreSQL&#xa;ADR must compare locking, installation, backup, migrations, recovery" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="localstack"><mxGeometry x="145" y="235" width="210" height="105" as="geometry"/></mxCell>

        <mxCell id="cloudstack" value="Proposed cloud stack — validate through ADR&#xa;API/sync: ASP.NET Core • Web: React + TypeScript&#xa;Cloud data: PostgreSQL • Files/backups: S3-compatible object storage&#xa;Identity: OIDC/OAuth 2.0 provider • Observability: OpenTelemetry&#xa;Deployment: managed container platform + CI/CD&#xa;All selections are provisional; keep contracts provider-neutral." style="swimlane;html=1;rounded=1;startSize=34;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1030" y="105" width="590" height="420" as="geometry"/></mxCell>
        <mxCell id="web" value="Responsive web / mobile administration&#xa;Proposed: React + TypeScript&#xa;Does not initially reproduce POS or control hardware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;" vertex="1" parent="cloudstack"><mxGeometry x="30" y="60" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="api" value="Cloud API and sync service&#xa;Proposed: ASP.NET Core&#xa;Versioned APIs/contracts; authorization in services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;" vertex="1" parent="cloudstack"><mxGeometry x="325" y="60" width="225" height="95" as="geometry"/></mxCell>
        <mxCell id="data" value="Cloud operational + reporting data&#xa;Proposed: PostgreSQL&#xa;Tenancy model and reporting architecture: validate" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;" vertex="1" parent="cloudstack"><mxGeometry x="50" y="230" width="210" height="95" as="geometry"/></mxCell>
        <mxCell id="platform" value="Cross-cutting platform services&#xa;Proposed: OIDC/OAuth 2.0 identity • S3-compatible backups/files&#xa;OpenTelemetry logs/metrics/traces • managed containers + CI/CD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;" vertex="1" parent="cloudstack"><mxGeometry x="310" y="220" width="240" height="115" as="geometry"/></mxCell>

        <mxCell id="integrations" value="Proposed integrations — provider selection is open" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="1580" height="280" as="geometry"/></mxCell>
        <mxCell id="payments" value="Payment gateway&#xa;Online payment approval / webhooks&#xa;Provider and offline policy: To validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;" vertex="1" parent="integrations"><mxGeometry x="30" y="65" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="fiscal" value="Argentina e-invoicing&#xa;Fiscal API / certified integration&#xa;Regulatory detail + provider: To validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;" vertex="1" parent="integrations"><mxGeometry x="270" y="65" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="notify" value="Notification providers&#xa;Email / SMS / WhatsApp&#xa;Channel provider and consent rules: To validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;" vertex="1" parent="integrations"><mxGeometry x="510" y="65" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="devices" value="Hardware adapters&#xa;Scanner HID/keyboard • scale serial/network • ESC/POS printers&#xa;Exact models/protocols: To validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;" vertex="1" parent="integrations"><mxGeometry x="750" y="65" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="romaneo" value="Independent automatic romaneo product&#xa;Proposed versioned API contract&#xa;Human confirmation before inventory movement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;" vertex="1" parent="integrations"><mxGeometry x="1020" y="65" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="imports" value="Excel and supplier documents&#xa;Validated import pipeline; OCR/AI suggestions require human review&#xa;Formats/providers: To validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;" vertex="1" parent="integrations"><mxGeometry x="1290" y="65" width="240" height="100" as="geometry"/></mxCell>

        <mxCell id="decision" value="ADR gates before commitment: local persistence/concurrency; desktop UI; cloud hosting and tenancy; payment, fiscal, notification, and hardware providers; sync conflict/authority model; remote identity continuity; backup/restore and update recovery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="940" width="1170" height="70" as="geometry"/></mxCell>

        <mxCell id="e1" value="LAN local API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="desktop" target="node"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="persisted operations + outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="node" target="localdata"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="bidirectional, idempotent sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;dashed=1;strokeWidth=2;" edge="1" parent="1" source="node" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="HTTPS API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="operations / reporting" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="api" target="data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="identity, files, telemetry, delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="api" target="platform"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="payment initiation + confirmation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="api" target="payments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="authorized documents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="api" target="fiscal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="campaigns / alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="api" target="notify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="terminal adapters" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="desktop" target="devices"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="confirmed results only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="romaneo" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="validated import / review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="imports" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
