<mxfile host="app.diagrams.net" modified="2026-09-11T00:00:00.000Z" agent="Codex" version="26.0.14" type="device">
  <diagram id="system-context-draft" name="System Context — DRAFT">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Incoders Commerce — System Context and Components [DRAFT]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1050" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Solid lines: document-derived responsibilities/connections. Dashed boxes/labels: proposed or to validate. Source: README.md, PRD.md, PRODUCT_VARIANTS_AND_RELEASE_STRATEGY.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="25" as="geometry"/></mxCell>

        <mxCell id="users" value="Users and external actors&#xa;Cashier • Branch manager • Delivery driver&#xa;Online customer • Remote administrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="channels" value="Operational channels&#xa;POS / local administration&#xa;Web/mobile administration&#xa;Online order portal&#xa;WhatsApp / telephone / counter orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="210" height="135" as="geometry"/></mxCell>

        <mxCell id="branch" value="Branch Local Environment&#xa;(Document-derived: each branch operates without Internet)" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="115" width="610" height="535" as="geometry"/></mxCell>
        <mxCell id="localclients" value="POS and operational clients&#xa;3 terminals per initial branch&#xa;No independent business database per terminal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="branch"><mxGeometry x="25" y="65" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="hardware" value="Hardware adapters&#xa;Scanner • Scale • Ticket/remittance printers • Cash drawer&#xa;Models/protocols: To validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="branch"><mxGeometry x="365" y="65" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="node" value="Branch Local Node&#xa;Local rules and data • Terminal coordination&#xa;Hardware integration • Diagnostics • Updates&#xa;Sync runs outside critical POS path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="branch"><mxGeometry x="155" y="205" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="domain" value="Modular commerce domain&#xa;Sales • Orders • Payments • Cash • Inventory&#xa;Customers • Purchasing • Delivery • Finance&#xa;Butchery module / future romaneo integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="branch"><mxGeometry x="30" y="380" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="localdb" value="Local operational store&#xa;Persisted operations and audit trail&#xa;Technology: To validate (SQLite vs local server DB)" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;" vertex="1" parent="branch"><mxGeometry x="355" y="390" width="200" height="95" as="geometry"/></mxCell>
        <mxCell id="outbox" value="Durable sync event queue&#xa;Global IDs • idempotency • retries&#xa;Persist until acknowledgement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="branch"><mxGeometry x="355" y="505" width="200" height="80" as="geometry"/></mxCell>

        <mxCell id="cloud" value="Cloud Platform&#xa;(Document-derived responsibilities; implementation design is open)" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="115" width="610" height="535" as="geometry"/></mxCell>
        <mxCell id="gateway" value="Cloud API and sync boundary&#xa;Receives local operations • routes cloud-originated changes&#xa;Authority is explicit by data type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="cloud"><mxGeometry x="185" y="65" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="cloudservices" value="Cloud capabilities&#xa;Online orders and payments • Remote administration&#xa;Consolidated reports • Campaigns / notifications&#xa;Backups • IA analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="cloud"><mxGeometry x="45" y="210" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="clouddb" value="Cloud operational / reporting store&#xa;Cross-branch exchange and consolidation&#xa;Technology and tenancy: To validate" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;" vertex="1" parent="cloud"><mxGeometry x="340" y="220" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="integrations" value="External integration boundary&#xa;Payment gateway • e-invoicing • notifications&#xa;Automatic romaneo product (future / separate)&#xa;Providers and contracts: To validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="cloud"><mxGeometry x="165" y="405" width="290" height="110" as="geometry"/></mxCell>

        <mxCell id="note1" value="Authority shown in PRD: local branch owns sale/cash, branch stock, hardware, preparation/delivery. Cloud owns online order, campaigns, consolidated reporting; online payment is gateway/cloud. Shared masters and identity continuity: pending." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="720" width="620" height="100" as="geometry"/></mxCell>
        <mxCell id="note2" value="Reusable core: a modular monolith with organization-enabled modules, configuration, permissions, and temporary feature flags is an existing proposed architecture decision. The butchery module is optional; the core remains commerce-generic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="720" width="610" height="100" as="geometry"/></mxCell>

