        <mxCell id="localdb" value="Local operational database&#xa;SQLite — provisional" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lan"><mxGeometry x="540" y="420" width="185" height="100" as="geometry"/></mxCell>
        <mxCell id="consistency" value="One authoritative local state&#xa;Each operation is validated and committed by the local node.&#xa;After commit, it publishes the change to every connected POS station.&#xa;POS stations do not maintain independent business databases." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="lan"><mxGeometry x="805" y="545" width="710" height="95" as="geometry"/></mxCell>
        <mxCell id="peripheralNote" value="Phase 1 baseline: each POS station has one scanner, one scale, and one receipt printer.&#xa;Shared-device layouts are separate client deployment diagrams." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="lan"><mxGeometry x="250" y="570" width="475" height="70" as="geometry"/></mxCell>

