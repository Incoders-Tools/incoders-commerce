        <mxCell id="wifi" value="Wireless router / access point&#xa;For authorized mobile devices" style="shape=mxgraph.cisco19.rect;prIcon=wireless_router;html=1;whiteSpace=wrap;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lan"><mxGeometry x="1775" y="395" width="150" height="85" as="geometry"/></mxCell>
