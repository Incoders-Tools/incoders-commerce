  <diagram id="local-branch-lan" name="Scalable Local Branch">
    <mxGraphModel dx="2200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Incoders Commerce — Scalable Local Branch Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Product baseline: 2 initial POS stations, designed to scale to N stations. Each station owns its peripherals; cloud is not required for local sales." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="1700" height="25" as="geometry"/></mxCell>

